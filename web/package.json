{
  "name": "great-family-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && vite",
    "build": "node scripts/prepare.mjs && node scripts/notices.mjs && vite build && node scripts/export.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs",
    "check:rpc": "node scripts/check-rpc.mjs",
    "test": "node tests/browser.mjs",
    "test:integrity": "node scripts/test-integrity.mjs",
    "test:service": "node tests/service.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
